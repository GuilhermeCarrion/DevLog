# Dev local: as duas URLs apontam pro Postgres do docker-compose.
# Produção (Neon): DATABASE_URL = string "pooled" (host com -pooler);
#                  DIRECT_URL   = string "direct" (sem -pooler), usada nas migrations.
DATABASE_URL="postgresql://devlog:devlog@localhost:5432/devlog?schema=public"
DIRECT_URL="postgresql://devlog:devlog@localhost:5432/devlog?schema=public"

# Troque por um segredo forte em produção (ex: `openssl rand -base64 32`)
JWT_SECRET="troque-por-um-segredo-forte"

PORT=3001

# URL do front. Em produção = URL do app na Vercel (https://seu-app.vercel.app)
WEB_ORIGIN="http://localhost:3000"
