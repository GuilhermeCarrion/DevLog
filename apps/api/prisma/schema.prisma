generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Neon usa connection pooling: `url` é a string pooled (runtime), `directUrl`
  // é a conexão direta usada pelas migrations. Em dev, ambas apontam pro Postgres local.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============ Auth ============

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String // hash bcrypt — nunca retornar em responses
  createdAt DateTime @default(now())

  // Defaults globais da calculadora de preço
  defaultHourlyRate Float @default(0) // valor/hora pré-preenchido em itens Dev
  defaultMargin     Float @default(30) // margem % sugerida

  projects           Project[]
  notes              Note[]
  agendaItems        AgendaItem[]
  tags               Tag[]
  costTemplates      CostTemplate[]
  periodCategories   PeriodCategory[]
  walletCategories   WalletCategory[]
  walletTransactions WalletTransaction[]
  recurringRules     RecurringRule[]
  installmentPlans   InstallmentPlan[]
}

// ============ Núcleo ============

model Project {
  id          String   @id @default(cuid())
  name        String
  description String? // descrição livre do projeto
  createdAt   DateTime @default(now())
  archived    Boolean  @default(false)

  marginPercent Float? // override da margem da calculadora (null = usa default do usuário)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  tags          Tag[] // M2M: tags reutilizáveis do usuário
  groups        Group[]
  tasks         Task[]
  sessions      WorkSession[]
  notes         Note[]
  reports       Report[]
  agendaItems   AgendaItem[]
  costItems     CostItem[]
  costPeriods   CostPeriod[]
  reportProfile ReportProfile?
  walletTransactions WalletTransaction[]
}

// ============ Calculadora de preço ============

enum CostCategory {
  CUSTO // infra e manutenções (fora do código)
  OUTROS // ferramentas, estudos, cursos, deslocamento
  DEV // mão de obra (valor/hora × horas)
  DESCONTO // abatimento no preço final
}

enum CostKind {
  FIXED // valor fixo (ex: VPS R$50)
  HOURLY // valor/hora × horas (ex: Dev R$5 × 30h)
}

// Item de custo dentro do cálculo de um projeto.
// `periodId == null` → item ativo (na lista "Custos lançados").
// `periodId != null` → arquivado num lançamento de período (fora do cálculo atual).
model CostItem {
  id        String       @id @default(cuid())
  projectId String
  project   Project      @relation(fields: [projectId], references: [id])
  name      String
  category  CostCategory @default(CUSTO)
  kind      CostKind     @default(FIXED)
  amount    Float // FIXED: o valor; HOURLY: o valor/hora
  hours     Float? // HOURLY: qtd de horas (null = puxa das sessões do projeto)
  position  Int          @default(0)
  createdAt DateTime     @default(now())

  periodId String?
  period   CostPeriod? @relation(fields: [periodId], references: [id], onDelete: SetNull)
}

// Custo padrão reutilizável do usuário (ex: "Claude Plus parcial" → 50)
model CostTemplate {
  id       String       @id @default(cuid())
  userId   String
  user     User         @relation(fields: [userId], references: [id])
  name     String
  category CostCategory @default(CUSTO)
  kind     CostKind     @default(FIXED)
  amount   Float
  hours    Float?
}

// Categoria de período de cobrança (ex: "Pago", "Pendente"), reutilizável por
// usuário — criada como os grupos de task (nome + cor).
model PeriodCategory {
  id      String       @id @default(cuid())
  name    String
  color   String // hex, ex: "#a3e635"
  userId  String
  user    User         @relation(fields: [userId], references: [id])
  periods CostPeriod[]

  @@unique([userId, name]) // nomes únicos por usuário
}

// Lançamento de período: registro histórico (ex: um pagamento) de um intervalo
// de datas do projeto. `hours`/`amount` são snapshot no momento de salvar — o
// histórico não muda se as sessões forem editadas depois.
model CostPeriod {
  id         String          @id @default(cuid())
  projectId  String
  project    Project         @relation(fields: [projectId], references: [id])
  categoryId String?
  category   PeriodCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  label      String? // rótulo livre, ex: "Pagamento de agosto"
  startDate  DateTime
  endDate    DateTime
  hours      Float           @default(0) // horas trabalhadas no período (snapshot)
  amount     Float           @default(0) // valor do período (snapshot)
  note       String? // detalhes livres do lançamento
  createdAt  DateTime        @default(now())

  items             CostItem[] // custos arquivados neste lançamento (limpos da lista ativa)
  walletTransaction WalletTransaction? // ganho lançado na Carteira a partir deste período
}

// Tag reutilizável, criada pelo usuário e aplicada a vários projetos (M2M).
// Ex: "Pessoal", "Em Desenvolvimento", "Next", "Nest", "Python".
model Tag {
  id       String    @id @default(cuid())
  name     String
  color    String // hex, ex: "#a3e635"
  userId   String
  user     User      @relation(fields: [userId], references: [id])
  projects Project[]

  @@unique([userId, name]) // nomes de tag únicos por usuário
}

// Metadados fixos do cabeçalho do relatório semanal — editáveis a qualquer momento
model ReportProfile {
  id           String  @id @default(cuid())
  projectId    String  @unique
  project      Project @relation(fields: [projectId], references: [id])
  grupoTurma   String
  aluno        String
  ra           String
  curso        String
  termo        String
  orientador   String
  coorientador String?
  tema         String
  area         String
}

model Group {
  id        String  @id @default(cuid())
  name      String
  color     String? // hex opcional, ex: "#a3e635"
  projectId String
  project   Project @relation(fields: [projectId], references: [id])
  tasks     Task[]
}

enum TaskStatus {
  BACKLOG
  EM_ANDAMENTO
  CONCLUIDO
  FUTURO // "Feature ou Futuro"
}

enum TaskPriority {
  BAIXA
  MEDIA
  ALTA
}

model Task {
  id          String        @id @default(cuid())
  title       String
  description String? // mantida atualizada = vira a Justificativa do relatório
  status      TaskStatus    @default(BACKLOG)
  priority    TaskPriority  @default(MEDIA)
  progress    Int           @default(0) // 0-100
  notes       String?
  projectId   String
  project     Project       @relation(fields: [projectId], references: [id])
  groupId     String?
  group       Group?        @relation(fields: [groupId], references: [id])
  sessions    WorkSession[] @relation("SessionTasks")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

// Status derivado (não persistido):
//   startedAt == null && plannedDoneAt == null → Plano/sprint (aparece em planejadas)
//   startedAt == null && plannedDoneAt != null → Plano concluído (fora das planejadas)
//   startedAt != null && endedAt == null && runningSince != null → Ativa (rodando)
//   startedAt != null && endedAt == null && runningSince == null → Pausada
//   startedAt != null && endedAt != null → Concluída
//
// Duração trabalhada = accumulatedSeconds (tempo ativo; exclui pausas).
model WorkSession {
  id         String    @id @default(cuid())
  projectId  String
  project    Project   @relation(fields: [projectId], references: [id])
  name       String? // nome do plano/sprint (nos templates)
  plannedFor DateTime? // preenchido quando planejada com antecedência
  startedAt  DateTime?
  endedAt    DateTime?

  // Pausa: tempo ativo acumulado (s) + início do segmento em andamento
  // (runningSince == null enquanto pausada; a duração nunca conta a pausa)
  accumulatedSeconds Int       @default(0)
  runningSince       DateTime?

  // Template/sprint: ao marcar concluído, o plano sai da lista de planejadas
  plannedDoneAt DateTime?

  // Vínculo de sprint: sessão trabalhada iniciada a partir de um plano
  parentId String?
  parent   WorkSession?  @relation("SessionChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children WorkSession[] @relation("SessionChildren")

  notes    String? // markdown livre
  commits  String? // texto livre: uma linha por commit
  nextStep String?
  tasks    Task[]  @relation("SessionTasks")
}

model Note {
  id        String   @id @default(cuid())
  projectId String? // opcional: nota pode ser geral (sem projeto)
  project   Project? @relation(fields: [projectId], references: [id])
  userId    String // dono da nota — escopo primário
  user      User     @relation(fields: [userId], references: [id])
  title     String
  content   String // markdown
  createdAt DateTime @default(now())
}

// ============ Agenda (módulo independente) ============

enum AgendaItemType {
  PRAZO
  ENTREGA
  LEMBRETE
  ANOTACAO
}

model AgendaItem {
  id          String         @id @default(cuid())
  title       String
  description String?
  date        DateTime
  type        AgendaItemType @default(LEMBRETE)
  done        Boolean        @default(false)
  // Opcional — a agenda funciona sozinha: itens pessoais existem sem projeto
  projectId   String?
  project     Project?       @relation(fields: [projectId], references: [id])
  // Vínculo primário é o usuário, não o projeto
  userId      String
  user        User           @relation(fields: [userId], references: [id])
  createdAt   DateTime       @default(now())
}

// ============ Relatório semanal (fase 2 — schema pronto, sem uso no POC) ============

model Report {
  id           String       @id @default(cuid())
  projectId    String
  project      Project      @relation(fields: [projectId], references: [id])
  week         String // ex: "20/2026"
  generatedAt  DateTime     @default(now())
  percentTotal Int
  filePath     String?
  // Snapshot do contexto renderizado (JSON) — permite rebaixar fiel depois,
  // independente de tasks/sessões/perfil terem mudado.
  contextJson  String?
  items        ReportItem[]
}

enum ReportSection {
  REALIZADAS
  PROXIMAS
}

model ReportItem {
  id            String        @id @default(cuid())
  reportId      String
  report        Report        @relation(fields: [reportId], references: [id])
  section       ReportSection
  taskTitle     String
  status        String // "Concluída" | "Em andamento" | "Em espera"
  percent       Int?
  justification String
}

// ============ Carteira (finanças pessoais) ============

enum TxType {
  INCOME
  EXPENSE
}

enum TxOrigin {
  MANUAL // lançamento avulso
  RECURRING // gerado por uma regra recorrente
  INSTALLMENT // parcela de uma compra
  PROJECT // importado de um período "Pago" da Calculadora
}

enum RecurrenceInterval {
  MONTHLY
  WEEKLY
  YEARLY
}

// Categoria com cor, reutilizável (mesmo padrão de Tag/PeriodCategory)
model WalletCategory {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])
  name   String
  color  String

  transactions   WalletTransaction[]
  recurringRules RecurringRule[]
  installments   InstallmentPlan[]

  @@unique([userId, name])
}

// Lançamento — unidade central da carteira
model WalletTransaction {
  id          String          @id @default(cuid())
  userId      String
  user        User            @relation(fields: [userId], references: [id])
  type        TxType
  amount      Float
  date        DateTime // competência / vencimento
  paid        Boolean         @default(false)
  paidAt      DateTime?
  description String
  categoryId  String?
  category    WalletCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  origin      TxOrigin        @default(MANUAL)

  // Vínculos de origem
  projectId    String?
  project      Project?    @relation(fields: [projectId], references: [id], onDelete: SetNull)
  costPeriodId String?     @unique // integração: 1 período gera no máx. 1 ganho
  costPeriod   CostPeriod? @relation(fields: [costPeriodId], references: [id], onDelete: SetNull)

  recurringRuleId String?
  recurringRule   RecurringRule? @relation(fields: [recurringRuleId], references: [id], onDelete: SetNull)

  installmentPlanId String?
  installmentPlan   InstallmentPlan? @relation(fields: [installmentPlanId], references: [id], onDelete: Cascade)
  installmentNumber Int? // parcela X de N

  createdAt DateTime @default(now())

  @@index([userId, date])
}

// Regra de recorrência (assinaturas, aluguel) — materializa transações
model RecurringRule {
  id               String              @id @default(cuid())
  userId           String
  user             User                @relation(fields: [userId], references: [id])
  type             TxType
  amount           Float
  description      String
  categoryId       String?
  category         WalletCategory?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  interval         RecurrenceInterval  @default(MONTHLY)
  dayOfMonth       Int? // ex: todo dia 5 (para MONTHLY)
  startDate        DateTime
  endDate          DateTime?
  active           Boolean             @default(true)
  lastGeneratedFor DateTime? // até quando já materializou
  transactions     WalletTransaction[]
}

// Compra parcelada — gera N transações mensais na criação
model InstallmentPlan {
  id                String              @id @default(cuid())
  userId            String
  user              User                @relation(fields: [userId], references: [id])
  type              TxType              @default(EXPENSE)
  description       String
  categoryId        String?
  category          WalletCategory?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  totalAmount       Float
  installmentsCount Int
  firstDueDate      DateTime
  createdAt         DateTime            @default(now())
  transactions      WalletTransaction[]
}
